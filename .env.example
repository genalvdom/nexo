# vLLM (OpenAI-compatible)
VLLM_BASE_URL=http://vllm-inference-service:8000/v1
VLLM_API_KEY=change-me
VLLM_MODEL=meta-llama/Llama-3.3-70B-Instruct
VLLM_IMAGE_TAG=
HF_TOKEN=

# Embeddings (separate pooling server); EMBEDDING_PROVIDER=fake for offline dev
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_BASE_URL=http://vllm-embedding-service:8000/v1
EMBEDDING_API_KEY=change-me
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024

# Neo4j (writer for ingestion; reader-role account for the agent tool)
NEO4J_URI=neo4j://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_READ_USER=
NEO4J_READ_PASSWORD=

# Sensitive data: none | regex | comprehend_medical (sends text to AWS; needs AWS_REGION + approval)
SENSITIVE_DATA_PROVIDER=regex
SENSITIVE_DATA_POLICY=tag
AWS_REGION=
DEFAULT_CLEARANCE=internal
# ALLOWED_RELATIONS=["ACQUIRED","SUPPLIES","DIAGNOSED_WITH","PRESCRIBED"]
# GLOSSARY_PATH=glossary.json

# Human-review checkpoints must outlive the process: sqlite (single node) or postgres
CHECKPOINT_BACKEND=sqlite
# CHECKPOINT_POSTGRES_URI=postgresql://user:pass@host:5432/graphrag

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_CAPTURE_CONTENT=false
DEPLOYMENT_ENVIRONMENT=dev
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=

# LLM-as-a-judge for `graphrag eval` (prefer a different model than the generator)
# JUDGE_BASE_URL=
# JUDGE_MODEL=
